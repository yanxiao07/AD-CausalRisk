<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Spring Boot 3.5.x is pinned deliberately to the last patch of the 3.5 line.
    Boot 4.x would move the stack to Spring Framework 7 / Jackson 3, which changes
    the Jackson package names used by the shared Envelope serialization and the
    JsonSchemaValidator wiring. Chosen version is recorded in backend/README.md.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.adcausalrisk</groupId>
  <artifactId>backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>ad-causalrisk-backend</name>
  <description>AD-CausalRisk Java business API: database migrations, authentication and subject scope</description>

  <properties>
    <java.version>21</java.version>
    <json-schema-validator.version>1.5.9</json-schema-validator.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.8</version>
    </dependency>
    <!-- Web / DTO validation / persistence / session security -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Method-level auditing (@AuditLog -> AuditLogAspect) needs the AOP starter; without it the
         aspect is silently not created and audited operations leave no trail. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- Versioned migrations. flyway-mysql is the Flyway 10+ module that carries
         MySQL support; flyway-core alone cannot migrate a MySQL 8 database. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- MySQL 8 is the target database (see backend/README.md). -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Test only: H2 in MySQL compatibility mode. No Docker / Testcontainers. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The research client validates the published candidate wire schema before semantic checks. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
    </dependency>
    <!-- Declared explicitly (not left to transitivity via spring-boot-starter-test)
         because Surefire loads this exact jar as a Java agent; see the build
         section below. Version is managed by the Boot BOM. -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource>
        <directory>${project.basedir}/../docs/contracts</directory>
        <targetPath>research-contract</targetPath>
        <includes><include>research-table-agent.draft.openapi.json</include></includes>
      </resource>
      <resource><directory>${project.basedir}/../docs</directory><targetPath>research-evidence</targetPath><includes><include>Training_Perturbation_Results.md</include><include>Graph_Training_Perturbation_Results.md</include><include>Graph_Modality_Strata_Results.md</include><include>Graph_Explanation_Results.md</include><include>Table_Grouped_XAI_Results.md</include><include>Causal_Identification_Results.md</include><include>Research_Host_Evidence_Admission.md</include><include>Feature_Drift_Monitoring.md</include><include>Performance_Monitoring.md</include><include>Lifecycle_Monitoring.md</include></includes></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Resolves ${org.mockito:mockito-core:jar} to an absolute path so Surefire
           can load Mockito as a Java agent. Mockito 5 otherwise attaches itself to
           the running JVM, which the JDK already warns about ("will no longer work
           in future releases of the JDK") and which fails outright in confined
           environments where a JVM may not attach to itself. Loading the agent at
           startup is Mockito's own documented configuration and keeps the inline
           mock maker fully functional. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>resolve-mockito-agent</id>
            <phase>initialize</phase>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            Both flags are needed; neither may replace the other.

            -javaagent: loads Mockito as an agent (see the note above). Removing it makes
                        Mockito fall back to attaching itself to the running JVM, which
                        fails in confined environments.

            -Xmx1g:     the suite starts three Spring application contexts in one forked JVM
                        (EnvelopeContractTest, AuthApiTest, SchemaMigrationTest) and Spring
                        caches them for the whole run. With no explicit ceiling the JVM
                        derives its maximum heap from the machine's RAM, which is too small
                        on a low-memory machine: that produced an OutOfMemoryError after
                        EnvelopeContractTest had finished, while JUnit was loading the next
                        test class. Pinning the heap makes the build depend on this file
                        rather than on the developer's hardware.
          -->
          <argLine>-javaagent:${org.mockito:mockito-core:jar} -Xmx1g</argLine>
          <!--
            Test classes share one in-memory H2 database, so the execution order decides
            which committed rows a later class can see. The default "filesystem" order
            depends on how the checkout wrote the files, which is why the same commit
            passed locally and failed on CI. alphabetical makes the order identical on
            every machine, so an order-dependent test cannot pass by luck.
          -->
          <runOrder>alphabetical</runOrder>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
